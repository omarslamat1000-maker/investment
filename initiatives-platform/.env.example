# متغيرات البيئة لمنصة المبادرات — انسخ إلى إعدادات Netlify (أو .env محلي خارج Git)
# لا تضع service_role أو أي مفتاح سري هنا أو في أي ملف داخل المستودع إطلاقًا

# رابط مشروع Supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# المفتاح القابل للنشر فقط (anon / publishable) — يُستخدم في الواجهة وتحكمه سياسات RLS
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# وضع التخزين: supabase (الإنتاج) أو indexeddb (عرض محلي بلا خادم)
STORAGE_MODE=supabase
